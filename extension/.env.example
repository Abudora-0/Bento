# Supabase project settings, Project Settings > API.
# Same project the website points at, that is what makes the two sync.
PLASMO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the "Open the tray" link in the popup footer goes.
PLASMO_PUBLIC_SITE_URL=http://localhost:3000
