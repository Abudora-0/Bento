# The two halves of the lock. The name is the one you type on the lock screen,
# the secret is the password, and the extension sends the same secret as a
# bearer token when it captures a tab.
#
# Generate a secret with: openssl rand -hex 24
BENTO_USER=your-name
BENTO_SECRET=change-me-to-something-long-and-random

# Minutes of no activity before Bento locks itself. Defaults to 30.
BENTO_LOCK_MINUTES=30

# Where the SQLite file and the screenshots directory live. Needs a real,
# persistent disk, this will not survive on a serverless platform with an
# ephemeral filesystem. Defaults to ./data if unset.
BENTO_DATA_DIR=./data

# Used to build absolute screenshot urls, and to decide whether the session
# cookie is marked Secure. Locally this is http://localhost:3000, once deployed
# use whatever origin you actually run this behind.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
