# The one secret. Your browser is asked for it via Basic Auth, and the
# extension sends it as a bearer token. Put anything long and random here,
# for example: openssl rand -hex 24
BENTO_SECRET=change-me-to-something-long-and-random

# Where the SQLite file and the screenshots directory live. Needs a real,
# persistent disk, this will not survive on a serverless platform with an
# ephemeral filesystem. Defaults to ./data if unset.
BENTO_DATA_DIR=./data

# Used to build absolute screenshot urls. Locally this is http://localhost:3000,
# once deployed use whatever origin you actually run this behind.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
