# The two halves of the lock. The name is the one you type on the lock screen,
# the secret is the password, and the extension sends the same secret as a
# bearer token when it captures a tab.
#
# Generate a secret with: openssl rand -hex 24
BENTO_USER=your-name
BENTO_SECRET=change-me-to-something-long-and-random

# Minutes of no activity before Bento locks itself. Defaults to 30.
BENTO_LOCK_MINUTES=30

# The database. Create one at turso.tech, then run: npm run db:push
# Pick a region close to wherever the app will run, not to you: the site makes
# far more trips to the database than your browser makes to the site.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token

# Screenshot storage. Vercel injects this when you attach a Blob store, so it
# is usually not set by hand. Without it captures still save, they just arrive
# without a picture.
# BLOB_READ_WRITE_TOKEN=

# Only used to decide whether the session cookie is marked Secure, and only
# when not on Vercel, which is detected on its own. Safe to leave alone.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
