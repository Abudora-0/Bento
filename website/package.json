{
  "name": "bento-website",
  "version": "1.0.0",
  "private": true,
  "description": "Bento, a contact sheet for everything you have saved.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "node --env-file-if-exists=.env.local scripts/db-push.mjs",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db-reset.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-loader.mjs --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"*.test.ts\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@vercel/blob": "^2.8.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
